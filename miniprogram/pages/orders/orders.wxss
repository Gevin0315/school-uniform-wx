@import '../../styles/theme.wxss';

.order-card {
  position: relative;
  padding: 28rpx 56rpx 28rpx 28rpx;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 28rpx;
}

.amount {
  font-size: 32rpx;
}

.order-id {
  margin-top: 10rpx;
  font-size: 22rpx;
}

.order-preview {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.order-chevron {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #aab3b8;
  font-size: 36rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-title {
  color: #70818b;
  font-size: 26rpx;
}
