<view class="compliance-banner">自愿选购 · 惠城 / 惠东样板区</view>

<view class="district-capsule" bindtap="changeDistrict">
  <text class="capsule-label">当前区县</text>
  <text class="capsule-value">{{districtName || '未选择'}}</text>
  <text class="capsule-change">更换 ›</text>
</view>

<view class="card">
  <view class="title">按季节选购</view>
  <view class="season-grid">
    <block wx:for="{{seasons}}" wx:key="seasonId">
      <view
        class="season-tile"
        data-season="{{item.seasonId}}"
        bindtap="openSeason"
      >
        <text class="season-name">{{item.label}}</text>
        <text class="season-hint">单买 / 套装</text>
      </view>
    </block>
  </view>
</view>

<view class="card set-entry" bindtap="openSetBundle">
  <view class="title">成套选购</view>
  <view class="muted">一键浏览当前区县全部套装款式</view>
  <text class="arrow">›</text>
</view>
