.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.district-list {
  margin: 0 24rpx;
}

.district-item {
  background: #fff;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.district-item.disabled {
  opacity: 0.55;
}

.arrow {
  color: #1a5fb4;
  font-size: 36rpx;
}

.link-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.link-row:last-child {
  border-bottom: none;
}
