.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.district-capsule {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.capsule-label {
  font-size: 22rpx;
  color: #888;
  margin-right: 12rpx;
}

.capsule-value {
  flex: 1;
  font-weight: 600;
}

.capsule-change {
  color: #1a5fb4;
  font-size: 24rpx;
}

.season-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.season-tile {
  width: calc(33.33% - 12rpx);
  background: #f0f6ff;
  border-radius: 12rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.season-name {
  display: block;
  font-weight: 600;
  color: #1a5fb4;
}

.season-hint {
  display: block;
  font-size: 20rpx;
  color: #888;
  margin-top: 8rpx;
}

.set-entry {
  position: relative;
  padding-right: 48rpx;
}

.set-entry .arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #1a5fb4;
  font-size: 36rpx;
}

.district-list {
  margin: 0 24rpx;
}

.district-item {
  background: #fff;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.district-item.disabled {
  opacity: 0.55;
}

.arrow {
  color: #1a5fb4;
  font-size: 36rpx;
}

.link-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.link-row:last-child {
  border-bottom: none;
}
