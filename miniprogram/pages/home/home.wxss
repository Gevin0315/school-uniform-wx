.district-capsule {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.capsule-label {
  font-size: 22rpx;
  color: #888;
  margin-right: 12rpx;
}

.capsule-value {
  flex: 1;
  font-weight: 600;
}

.capsule-change {
  color: #1a5fb4;
  font-size: 24rpx;
}

.filter-section {
  margin: 0 24rpx 8rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  flex-shrink: 0;
  width: 72rpx;
  font-size: 22rpx;
  color: #888;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
  display: flex;
  gap: 12rpx;
}

.filter-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #f5f6f8;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}

.tab.active {
  background: #1a5fb4;
  color: #fff;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.set-btn {
  flex: 1;
  margin-right: 16rpx;
}

.product-card {
  display: flex;
  gap: 20rpx;
}

.placeholder-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #e8eef5, #d0dce8);
  flex-shrink: 0;
}

.info {
  flex: 1;
}

.name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.price {
  color: #c0392b;
  font-weight: 600;
}

.stock-ok {
  color: #2e7d32;
  font-size: 22rpx;
}

.stock-low {
  color: #e65100;
  font-size: 22rpx;
}

.stock-out {
  color: #999;
  font-size: 22rpx;
}
