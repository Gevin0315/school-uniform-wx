@import '../../styles/theme.wxss';

.privacy-note {
  padding: 12rpx 24rpx 0;
  font-size: 22rpx;
}

.radio-line {
  display: block;
  padding: 16rpx 0;
  color: #203342;
  font-size: 28rpx;
}

.picker-line {
  padding: 20rpx 0;
  color: #183f5b;
  font-weight: 600;
  border-bottom: 1rpx solid #edf0f1;
}

.pickup-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.submit-card {
  margin-bottom: 48rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 28rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #203342;
}

.amount-value {
  font-size: 40rpx;
}

.submit-btn {
  width: 100%;
  line-height: 88rpx;
  height: 88rpx;
  margin: 0;
  font-size: 30rpx;
}
