<view class="page-shell">
  <view class="compliance-banner">提交后进入待支付，支付按钮为占位（非真收款）</view>
  <view class="privacy-note muted">隐私：仅收集必要收货信息，不采集学生学籍等敏感信息。</view>

  <view class="card">
    <view class="section-title">配送方式</view>
    <radio-group class="radio-group" bindchange="setFulfillment">
      <label class="radio-line">
        <radio value="express" color="#183f5b" checked="{{fulfillmentType === 'express'}}"/> 快递寄送（填写地址）
      </label>
      <label class="radio-line">
        <radio value="pickup" color="#183f5b" checked="{{fulfillmentType === 'pickup'}}"/> 区县虚拟自提
      </label>
    </radio-group>
  </view>

  <view class="card" wx:if="{{fulfillmentType === 'express'}}">
    <view class="section-title">收货地址</view>
    <input class="field-input" placeholder="收货人" placeholder-class="field-input-placeholder" value="{{address.name}}" data-field="name" bindinput="onInput" />
    <input class="field-input" placeholder="手机号" placeholder-class="field-input-placeholder" type="number" value="{{address.phone}}" data-field="phone" bindinput="onInput" />
    <input class="field-input" placeholder="详细地址" placeholder-class="field-input-placeholder" value="{{address.detail}}" data-field="detail" bindinput="onInput" />
  </view>

  <view class="card" wx:if="{{fulfillmentType === 'pickup'}}">
    <view class="section-title">自提点 · {{districtName}}</view>
    <picker range="{{pickupPoints}}" range-key="name" bindchange="onPickupChange">
      <view class="picker-line">{{pickupPoints[pickupIndex].name || '请选择自提点'}}</view>
    </picker>
    <view class="muted pickup-hint">可选填联系人手机，便于自提通知</view>
    <input class="field-input" placeholder="联系人（选填）" placeholder-class="field-input-placeholder" value="{{address.name}}" data-field="name" bindinput="onInput" />
    <input class="field-input" placeholder="手机号（选填）" placeholder-class="field-input-placeholder" type="number" value="{{address.phone}}" data-field="phone" bindinput="onInput" />
  </view>

  <view class="card submit-card">
    <view class="amount-row">
      <text class="amount-label">商品合计</text>
      <text class="amount-value text-price">¥ {{totalText}}</text>
    </view>
    <button class="btn-primary submit-btn" bindtap="submitOrder">提交订单</button>
  </view>
</view>
