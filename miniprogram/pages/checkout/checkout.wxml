<view class="compliance-banner">支付为 mock 演示，非真收款</view>

<view class="card">
  <view class="section">配送方式</view>
  <radio-group bindchange="setFulfillment">
    <label><radio value="express" checked="{{fulfillmentType === 'express'}}"/> 快递寄送</label>
    <label><radio value="pickup" checked="{{fulfillmentType === 'pickup'}}"/> 区县自提（虚拟点）</label>
  </radio-group>
</view>

<view class="card" wx:if="{{fulfillmentType === 'express'}}">
  <input placeholder="收货人" data-field="name" bindinput="onInput" />
  <input placeholder="手机号" type="number" data-field="phone" bindinput="onInput" />
  <input placeholder="详细地址" data-field="detail" bindinput="onInput" />
</view>

<view class="card" wx:if="{{fulfillmentType === 'pickup'}}">
  <picker range="{{pickupPoints}}" range-key="name" bindchange="onPickupChange">
    <view>自提点：{{pickupPoints[pickupIndex].name || '请选择'}}</view>
  </picker>
</view>

<view class="card muted">
  <checkbox-group bindchange="onSimulateChange">
    <label><checkbox value="1"/> 测试环境：模拟已付（仅联调履约，仍非真收款）</label>
  </checkbox-group>
</view>

<view class="card">
  <view>合计 ¥ {{totalText}}</view>
  <button class="btn-primary" bindtap="submitOrder">提交订单 · mockPay</button>
</view>
