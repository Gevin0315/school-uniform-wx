@import '../../styles/theme.wxss';

.summary-card {
  margin-top: 0;
}

.status-pill {
  color: #183f5b;
  font-weight: 700;
}

.payment-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.line-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f1;
}

.line-item:last-child {
  border-bottom: none;
}

.name {
  font-weight: 600;
  color: #203342;
}

.line-price {
  margin-top: 8rpx;
  text-align: right;
  font-size: 30rpx;
}

.pickup .code {
  font-family: monospace;
  font-weight: 700;
  color: #183f5b;
  letter-spacing: 2rpx;
  font-size: 30rpx;
}

.pickup-status {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.pickup-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.pay-block {
  margin-top: 0;
}

.pay-btn {
  width: 100%;
  line-height: 88rpx;
  height: 88rpx;
  margin: 0;
}

.pay-hint {
  text-align: center;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.after-btn {
  margin: 0 24rpx 48rpx;
  line-height: 88rpx;
  height: 88rpx;
}
