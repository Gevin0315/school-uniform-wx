<view class="compliance-banner">仅保存必要收货信息，不采集学生敏感信息</view>

<view class="card">
  <input placeholder="收货人" value="{{address.name}}" data-field="name" bindinput="onInput" />
  <input placeholder="手机号" type="number" value="{{address.phone}}" data-field="phone" bindinput="onInput" />
  <input placeholder="详细地址" value="{{address.detail}}" data-field="detail" bindinput="onInput" />
</view>

<button class="btn-primary save-btn" bindtap="save">保存地址</button>
