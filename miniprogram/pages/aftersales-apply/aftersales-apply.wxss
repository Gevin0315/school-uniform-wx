@import '../../styles/theme.wxss';

.order-line {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.state {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.picker {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f1;
  color: #203342;
}

.note {
  margin-top: 20rpx;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 16rpx;
  background: #f0f3f4;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #203342;
}

.demo-card {
  font-size: 24rpx;
  line-height: 1.5;
}

.submit-btn {
  margin: 8rpx 24rpx 48rpx;
  line-height: 88rpx;
  height: 88rpx;
  font-size: 30rpx;
}
