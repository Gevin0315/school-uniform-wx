<view class="compliance-banner">自愿选购，请核对尺码与数量</view>

<block wx:for="{{items}}" wx:key="skuId">
  <view class="card item">
    <view class="row-top">
      <view class="name">{{item.name}}</view>
      <text class="delete" data-sku="{{item.skuId}}" bindtap="removeLine">删除</text>
    </view>
    <view class="muted">尺码 {{item.size}} · {{item.typeLabel}}</view>
    <view wx:if="{{item.componentLines.length}}" class="components">
      <view class="comp-title">套装扣减组件 SKU：</view>
      <block wx:for="{{item.componentLines}}" wx:for-item="comp" wx:key="skuId">
        <view class="comp-line muted">· {{comp.name}}（余 {{comp.stock}}）</view>
      </block>
    </view>
    <view class="row">
      <view class="qty">
        <text data-sku="{{item.skuId}}" data-delta="-1" bindtap="changeQty">－</text>
        <text class="num">{{item.qty}}</text>
        <text data-sku="{{item.skuId}}" data-delta="1" bindtap="changeQty">＋</text>
      </view>
      <text>¥ {{item.lineTotalText}}</text>
    </view>
  </view>
</block>

<view wx:if="{{items.length === 0}}" class="footer-note">购物车暂无商品</view>

<view class="bar" wx:if="{{items.length}}">
  <text>合计 ¥ {{totalText}}</text>
  <button class="btn-primary" size="mini" bindtap="checkout">去结算</button>
</view>
