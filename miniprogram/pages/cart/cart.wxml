<view class="page-shell page-shell-pad-bar">
  <view class="compliance-banner">自愿选购，请核对尺码与数量</view>

  <block wx:for="{{items}}" wx:key="skuId">
    <view class="card item">
      <view class="row-top">
        <view class="name">{{item.name}}</view>
        <text class="delete" data-sku="{{item.skuId}}" bindtap="removeLine">删除</text>
      </view>
      <view class="muted">尺码 {{item.size}} · {{item.typeLabel}}</view>
      <view wx:if="{{item.componentLines.length}}" class="components">
        <view class="comp-title">套装扣减组件 SKU</view>
        <block wx:for="{{item.componentLines}}" wx:for-item="comp" wx:key="skuId">
          <view class="comp-line muted">· {{comp.name}}（余 {{comp.stock}}）</view>
        </block>
      </view>
      <view class="row">
        <view class="qty qty-stepper">
          <text data-sku="{{item.skuId}}" data-delta="-1" bindtap="changeQty">－</text>
          <text class="num">{{item.qty}}</text>
          <text data-sku="{{item.skuId}}" data-delta="1" bindtap="changeQty">＋</text>
        </view>
        <text class="line-total text-price">¥ {{item.lineTotalText}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{items.length === 0}}" class="empty-card card">
    <text class="empty-title">购物车暂无商品</text>
    <text class="muted">去首页挑选校服吧</text>
  </view>

  <view class="bottom-bar" wx:if="{{items.length}}">
    <view>
      <text class="bottom-bar-total">合计 </text>
      <text class="bottom-bar-amount">¥ {{totalText}}</text>
    </view>
    <button class="btn-primary checkout-btn" bindtap="checkout">去结算</button>
  </view>
</view>
