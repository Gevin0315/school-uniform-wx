.item .name {
  font-weight: 600;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.qty text {
  padding: 8rpx 20rpx;
  background: #eee;
  margin: 0 8rpx;
  border-radius: 6rpx;
}

.bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
