@import '../../styles/theme.wxss';

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.name {
  font-weight: 700;
  color: #203342;
  flex: 1;
  line-height: 1.4;
}

.delete {
  color: #c2674f;
  font-size: 24rpx;
}

.components {
  margin: 16rpx 0;
  padding: 16rpx;
  background: #f0f3f4;
  border-radius: 24rpx;
}

.comp-title {
  font-size: 22rpx;
  color: #70818b;
}

.comp-line {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.line-total {
  font-size: 32rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-title {
  display: block;
  font-weight: 700;
  color: #203342;
  margin-bottom: 8rpx;
}

.checkout-btn {
  margin: 0;
  min-width: 200rpx;
  line-height: 80rpx;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
}
