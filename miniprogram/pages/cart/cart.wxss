.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.name {
  font-weight: 600;
  flex: 1;
}

.delete {
  color: #c0392b;
  font-size: 24rpx;
}

.components {
  margin: 12rpx 0;
  padding: 12rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.comp-title {
  font-size: 22rpx;
  color: #666;
}

.comp-line {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.qty text {
  display: inline-block;
  width: 56rpx;
  text-align: center;
  padding: 8rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
}

.qty .num {
  background: transparent;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
