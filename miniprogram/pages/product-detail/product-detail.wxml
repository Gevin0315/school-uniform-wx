<view class="compliance-banner" wx:if="{{product}}">{{product.complianceNote}}</view>

<view class="hero card" wx:if="{{product}}">
  <view class="hero-cover placeholder-cover" />
  <view class="name">{{product.name}}</view>
  <view class="muted">{{districtLabel}} · {{product.typeLabel}}</view>
  <view wx:if="{{selectedSku}}" class="price">¥ {{priceText}}</view>
</view>

<view class="card">
  <view class="section-title">尺码（110–180）</view>
  <view class="size-row">
    <block wx:for="{{sizeChart}}" wx:key="*this">
      <view
        class="size-chip {{selectedSize === item ? 'active' : ''}}"
        data-size="{{item}}"
        bindtap="pickSize"
      >{{item}}</view>
    </block>
  </view>
  <view wx:if="{{selectedSize}}" class="stock-line">库存：{{stock}} 件</view>
  <view class="qty-row">
    <text>数量</text>
    <view class="qty">
      <text data-delta="-1" bindtap="changeQty">－</text>
      <text class="num">{{qty}}</text>
      <text data-delta="1" bindtap="changeQty">＋</text>
    </view>
  </view>
</view>

<view class="card policy">
  <view class="section-title">退换规则</view>
  <text class="muted">{{returnPolicy}}</text>
</view>

<view class="action-bar" wx:if="{{product}}">
  <button class="btn-secondary flex" bindtap="addCart">加入购物车</button>
  <button
    wx:if="{{product.type === 'set'}}"
    class="btn-primary flex"
    bindtap="addSetBundle"
  >成套加购</button>
  <button wx:else class="btn-primary flex" bindtap="addCart">立即加购</button>
</view>
