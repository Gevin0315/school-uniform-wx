<view class="compliance-banner" wx:if="{{product}}">{{product.complianceNote}}</view>

<view class="card" wx:if="{{product}}">
  <view class="name">{{product.name}}</view>
  <view class="muted">{{product.typeLabel}}</view>
</view>

<view class="card">
  <view class="section-title">尺码表（占位 110–180）</view>
  <view class="size-row">
    <block wx:for="{{sizeChart}}" wx:key="*this">
      <view
        class="size-chip {{selectedSize === item ? 'active' : ''}}"
        data-size="{{item}}"
        bindtap="pickSize"
      >{{item}}</view>
    </block>
  </view>
  <view wx:if="{{selectedSku}}" class="price">¥ {{priceText}} · 库存 {{stock}}</view>
</view>

<button class="btn-primary add-btn" bindtap="addCart">加入购物车</button>
