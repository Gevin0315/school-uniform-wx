.page-detail {
  min-height: 100vh;
  background: #f6f7f6;
  padding-bottom: 160rpx;
}

.hero-swiper {
  height: 536rpx;
  margin: 0 24rpx;
  border-radius: 36rpx;
  overflow: hidden;
}

.hero-slide,
.placeholder-cover {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e5edf1, #cbd9df);
}

.hero-indicator {
  text-align: right;
  padding: 8rpx 32rpx 0;
  font-size: 22rpx;
}

.detail-body {
  padding: 16rpx 24rpx 0;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #203342;
  line-height: 1.35;
}

.meta-line {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.price-main {
  display: block;
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #c2674f;
}

.size-card {
  margin: 24rpx 0 0;
}

.size-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #253946;
}

.size-guide {
  font-size: 22rpx;
  color: #829097;
}

.size-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.size-chip {
  min-width: 96rpx;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 18rpx;
  background: #f4f6f6;
  color: #53636b;
  font-size: 24rpx;
}

.size-chip.active {
  background: #183f5b;
  color: #fff;
}

.stock-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.qty-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0f1;
}

.qty-label {
  color: #203342;
  font-size: 26rpx;
}

.qty text {
  display: inline-block;
  width: 56rpx;
  text-align: center;
  padding: 8rpx;
  background: #f0f3f4;
  border-radius: 12rpx;
  color: #183f5b;
}

.qty .num {
  background: transparent;
  min-width: 48rpx;
  color: #203342;
}

.aftersales-card {
  margin-top: 24rpx;
}

.aftersales-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f6f7f6;
  box-shadow: 0 -8rpx 24rpx rgba(22, 51, 75, 0.06);
}

.action-outline {
  flex: 0 0 240rpx;
  margin: 0;
  font-size: 28rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}

.action-solid {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}
