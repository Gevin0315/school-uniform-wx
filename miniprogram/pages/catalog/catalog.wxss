@import '../../styles/theme.wxss';

.hint-bar {
  padding: 8rpx 28rpx 0;
  font-size: 22rpx;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.toolbar-btn {
  margin: 0;
  min-width: 160rpx;
  line-height: 64rpx;
  height: 64rpx;
  font-size: 26rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 24rpx 24rpx;
}

.product-tile {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #e9edef;
  box-shadow: 0 8rpx 24rpx rgba(22, 51, 75, 0.04);
}

.tile-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 24rpx;
}

.placeholder-cover {
  background: linear-gradient(135deg, #eaf0f2, #d4e0e4);
}

.tile-name {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #263a49;
  line-height: 1.35;
}

.tile-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 10rpx;
}

.stock-ok {
  color: #718d76;
  font-size: 20rpx;
}

.stock-low {
  color: #c2674f;
  font-size: 20rpx;
}

.stock-out {
  color: #829097;
  font-size: 20rpx;
}
