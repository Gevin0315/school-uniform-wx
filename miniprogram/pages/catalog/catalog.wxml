<view class="page-shell">
  <view class="compliance-banner">自愿选购 · {{districtName}}</view>

  <view class="hint-bar muted" wx:if="{{setsOnly}}">从列表进入详情，选择尺码后加购（不自动组套）</view>

  <view class="chip-row season-chips">
    <view
      class="chip {{filterSeason === '' ? 'chip-active' : ''}}"
      data-season=""
      bindtap="onSeasonTap"
    >全部</view>
    <block wx:for="{{seasons}}" wx:key="seasonId">
      <view
        class="chip {{filterSeason === item.seasonId ? 'chip-active' : ''}}"
        data-season="{{item.seasonId}}"
        bindtap="onSeasonTap"
      >{{item.label}}</view>
    </block>
  </view>

  <view class="toolbar card" wx:if="{{!setsOnly}}">
    <button class="btn-secondary toolbar-btn" size="mini" bindtap="goCart">购物车</button>
  </view>

  <view class="product-grid">
    <block wx:for="{{displayProducts}}" wx:key="productId">
      <view class="product-tile" data-id="{{item.productId}}" bindtap="openProduct">
        <view class="tile-cover placeholder-cover" />
        <text class="tile-name">{{item.name}}</text>
        <view class="tile-meta">
          <text class="text-price">¥ {{item.priceText}}</text>
          <text class="stock stock-{{item.stockLevel}}">{{item.stockText}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{displayProducts.length === 0}}" class="footer-note">暂无商品，请切换季节或区县</view>
</view>
