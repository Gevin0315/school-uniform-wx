@import '../../styles/theme.wxss';

.intro-card {
  margin-bottom: 8rpx;
}

.intro-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.district-list {
  padding: 0 24rpx;
}

.district-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 32rpx 28rpx;
}

.district-item.disabled {
  opacity: 0.55;
}

.district-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #203342;
}

.arrow {
  color: #aab3b8;
  font-size: 36rpx;
}
