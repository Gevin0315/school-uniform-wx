<view class="page-shell">
  <view class="compliance-banner">校服自愿选购，非强制、非指定商家</view>

  <view class="district-bar-beige">
    <text class="district-bar-main">📍 {{currentDistrictLabel}} ⌄</text>
    <text class="district-bar-link" catchtap="goRules">自愿选购 · 了解说明 ›</text>
  </view>

  <view class="weak-hint muted">选区为选购偏好，用于「我的」与结算自提；不选也可在首页浏览全量商品</view>

  <view class="section block-section">
    <text class="section-title">可选校区</text>
    <view class="chip-row chip-row-inset">
      <block wx:for="{{enabledDistricts}}" wx:key="districtId">
        <view
          class="chip {{selectedDistrictId === item.districtId ? 'chip-active' : ''}}"
          data-id="{{item.districtId}}"
          data-name="{{item.name}}"
          data-enabled="{{item.enabled}}"
          bindtap="onSelectDistrict"
        >{{item.name}}</view>
      </block>
    </view>
  </view>

  <view class="section" wx:if="{{disabledDistricts.length}}">
    <text class="section-title muted-title">即将开放</text>
    <block wx:for="{{disabledDistricts}}" wx:key="districtId">
      <view class="disabled-row">
        <text>{{item.name}}</text>
        <text class="tag-disabled">即将开放</text>
      </view>
    </block>
  </view>

  <button class="btn-secondary skip-btn" bindtap="goBackWeak">暂不选择，返回</button>

  <view class="footer-note">{{complianceFooter}}</view>
</view>
