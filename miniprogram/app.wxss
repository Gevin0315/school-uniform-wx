page {
  background: #e9edf0;
  color: #203342;
  font-size: 28rpx;
  line-height: 1.5;
}

.compliance-banner {
  background: #f5f1e9;
  color: #7c6746;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  border-bottom: 1rpx solid #ebe4d8;
}

.btn-primary {
  background: #183f5b;
  color: #fff;
  border-radius: 28rpx;
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #8fa8b8;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #183f5b;
  border: 2rpx solid #183f5b;
  border-radius: 28rpx;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(22, 51, 75, 0.06);
}

.muted {
  color: #829097;
  font-size: 24rpx;
}

.tag-disabled {
  color: #70818b;
  background: #f0f3f4;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.footer-note {
  padding: 32rpx 24rpx 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #70818b;
}
