page {
  background: #f5f6f8;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.5;
}

.compliance-banner {
  background: #fff8e6;
  color: #8a6d3b;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  border-bottom: 1rpx solid #f0e6c8;
}

.btn-primary {
  background: #1a5fb4;
  color: #fff;
  border-radius: 8rpx;
}

.btn-primary[disabled] {
  background: #a0c4e8;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #1a5fb4;
  border: 1rpx solid #1a5fb4;
  border-radius: 8rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  margin: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.tag-disabled {
  color: #aaa;
  background: #eee;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.footer-note {
  padding: 32rpx 24rpx 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}
